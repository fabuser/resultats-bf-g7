# -*- mode: ruby -*-
require 'yaml'
require 'fileutils'

GROUPE = (ENV['GROUPE'] || 7).to_i
NB_APP = (ENV['NB_APP'] || 2).to_i
RESEAU = "192.168.#{55 + GROUPE}" # Résulte en 192.168.62 pour le groupe 7[span_3](start_span)[span_3](end_span)
BOITE  = "bento/ubuntu-24.04"
VERSION = "202404.26.0"

NOEUDS = []

# Base de données primaire et réplique (Socle obligatoire)
NOEUDS << { nom: "bdd1", ip: "#{RESEAU}.31", mem: 768, role: "bdd" }
NOEUDS << { nom: "bdd2", ip: "#{RESEAU}.32", mem: 768, role: "replique" }

# Serveurs applicatifs dynamiques (N paramétrable)
(1..NB_APP).each do |i|
  NOEUDS << { nom: "app#{i}", ip: "#{RESEAU}.#{20 + i}", mem: 512, role: "app" }
end

# Répartiteurs de charge (Socle + Extension E1)
NOEUDS << { nom: "lb1", ip: "#{RESEAU}.11", mem: 512, role: "lb" }
NOEUDS << { nom: "lb2", ip: "#{RESEAU}.12", mem: 512, role: "lb" }

# Supervision (Extension E2)
NOEUDS << { nom: "obs", ip: "#{RESEAU}.41", mem: 768, role: "obs" }

# Génération du fichier YAML source unique
FileUtils.mkdir_p("config")
File.write("config/noeuds.yml", NOEUDS.to_yaml)

Vagrant.configure("2") do |config|
  config.vm.box = BOITE
  config.vm.box_version = VERSION

  NOEUDS.each do |n|
    config.vm.define n[:nom] do |m|
      m.vm.hostname = n[:nom]
      m.vm.network "private_network", ip: n[:ip]
      
      # Redirection de port sur lb1 pour accéder à l'application depuis l'hôte
      m.vm.network "forwarded_port", guest: 80, host: 8080 if n[:role] == "lb" && n[:nom] == "lb1"

      # Redirection de port sur obs pour accéder à Prometheus depuis l'hôte
      m.vm.network "forwarded_port", guest: 9090, host: 9090 if n[:nom] == "obs"

      m.vm.provider "virtualbox" do |vb|
        vb.memory = n[:mem]
        vb.cpus = 1
      end

      m.vm.provision "shell", path: "scripts/#{n[:role]}.sh"
    end
  end
end