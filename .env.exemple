# Copier ce fichier en .env puis adapter (cp .env.exemple .env). Le fichier .env n'est JAMAIS versionné.

# --- Paramètres d'infrastructure ---
GROUPE=7                 # numéro de groupe (1..8) -> sous-réseau 192.168.(55+G).0/24
NB_APP=2                 # nombre de serveurs applicatifs (2..9) : LA valeur à changer pour passer à l'échelle
EXTENSIONS=              # extensions actives, séparées par des virgules : E1 (lb2+VRRP), E2 (obs). Ex : E1,E2

# --- Secrets (à changer ! valeurs d'exemple volontairement faibles) ---
# Ne pas mettre d'espace suivi de # dans une valeur (interprété comme un commentaire).
DB_NAME=bdata
DB_USER=appuser
DB_PASSWORD=
REPL_PASSWORD=
VRRP_PASSWORD=   # 8 caractères max (limite du protocole VRRP)
GRAFANA_PASSWORD=